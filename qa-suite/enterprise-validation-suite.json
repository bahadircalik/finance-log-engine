					"raw": "{\n  \"txn_id\": \"TXN-NODE-CLEAN-01\",\n  \"op\": \"SALE\",\n  \"amt\": 450.00,\n  \"curr\": \"TRY\",\n  \"bank\": \"Akbank\",\n  \"store\": \"Starbucks\",\n  \"mcc\": 5812,\n  \"city\": \"Istanbul\",\n  \"lat\": 41.0082,\n  \"lon\": 28.9784,\n  \"auth\": \"CONTACTLESS\",\n  \"status\": \"SUCCESS\",\n  \"user\": \"operator_alpha\"\n}",

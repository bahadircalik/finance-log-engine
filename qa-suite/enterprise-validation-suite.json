{
	"info": {
		"name": "Enterprise Finance Log Engine - QA Verification Suite",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. API Operator Authentication (Login)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if(jsonData.token) {",
							"    pm.collectionVariables.set(\"current_jwt_token\", jsonData.token);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"body": {
					"mode": "raw",
					"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"ProductionPassword2026!\"\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": { "raw": "http://localhost:3000/login" }
			}
		},
		{
			"name": "2. Node API: Valid Clean Transaction",
			"request": {
				"method": "POST",
